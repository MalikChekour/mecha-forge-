+	if _hitstop_until_ms > now:
+		_hitstop_until_ms = now + _HITSTOP_MS
+		return
+	_hitstop_restore = Engine.time_scale if Engine.time_scale > 0.2 else 1.0
+	Engine.time_scale = _HITSTOP_SCALE
+	_hitstop_until_ms = now + _HITSTOP_MS
