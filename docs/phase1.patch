+func _end_hitstop() -> void:
+	if _hitstop_until_ms <= 0:
+		return
+	if is_equal_approx(Engine.time_scale, _HITSTOP_SCALE):
+		Engine.time_scale = _hitstop_restore
+	_hitstop_until_ms = 0
