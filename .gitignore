# Godot import/build caches (regenerated by `--import` / export)
game/.godot/
game/build/
game/android/
# Deployed web builds (throwaway, huge wasm/pck — never commit)
web/
# keystores (never commit signing material)
*.keystore
*.jks
# Python
__pycache__/
*.pyc
# scratch renders
*.tmp
# Meshy source GLBs + secrets (never commit keys)
meshy_in/
.meshy_key
.glm_key
.env
*.key
# transient bake frames
**/_animframe.png
**/_tmp/
# temp backup of the old blurred ground textures (superseded by clean Gemini re-encode)
.ground_blurred_backup/
